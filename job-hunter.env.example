# Core LLM
# Pick one provider shape below and keep only the values you need.

# Option A: OpenAI or any OpenAI-compatible hosted provider
LLM_BASE_URL=https://api.openai.com/v1
JOB_HUNTER_LLM_KEY=put-your-llm-api-key-here
LLM_MODEL=gpt-4.1-mini

# Option B: Ollama Cloud / ollama.com
# LLM_BASE_URL=https://ollama.com/v1
# JOB_HUNTER_LLM_KEY=put-your-ollama-cloud-key-here
# LLM_MODEL=deepseek-v3.1:671b

# Option C: local Ollama server
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# JOB_HUNTER_LLM_KEY=ollama
# LLM_MODEL=qwen2.5:14b

# Retry the primary provider after a temporary fallback window.
# LLM_PROVIDER_FALLBACK_TTL_SECONDS=300
# Restrict providers explicitly; unlisted providers will not be called.
# LLM_PROVIDER_ORDER=groq,groq2
# Emergency temporary compatibility path, until Job Hunter migrates to AI Gateway.
# Put these optional slots in ~/.job-hunter/llm-providers.env (LAN address is private).
# Explicit *_FALLBACK_MODEL maps every TEXT request within that slot only.
# Vision/CAPTCHA/image requests skip these text-only slots. Other aliases stay intact.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_API_KEY=ollama
# OLLAMA_FALLBACK_MODEL=qwen3-coder:30b
# OLLAMA_TIMEOUT_SECONDS=60
# OLLAMA2_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA2_API_KEY=ollama2
# OLLAMA2_FALLBACK_MODEL=qwen3:8b
# OLLAMA2_TIMEOUT_SECONDS=60
# OLLAMA3_FALLBACK_MODEL and OLLAMA3_TIMEOUT_SECONDS are also supported.
# LLM_PROVIDER_ORDER=groq,groq2,ollama,ollama2
# LAN slots bypass LLM_PROXY; connect <=3s, whole completion <= configured timeout.
# Disable emergency slots by removing ollama/ollama2 from LLM_PROVIDER_ORDER.
# Optional dedicated HTTP/SOCKS proxy; system proxy variables are ignored.
# LLM_PROXY=http://127.0.0.1:8080

# Profession policy, also supported per profile: qa (default) or generic.
# generic skips QA-only gates in both the prefilter and matcher.
# VACANCY_FILTER_POLICY=generic
# VACANCY_RELEVANT_KEYWORDS=электрик||электромонтаж
# VACANCY_EXCLUDE_KEYWORDS=вахта||продажи

# Chat responder safety limits.
# HH_CHAT_MAX_SCAN=25

# Structured HH application traces (JSONL + summary + selected artifacts).
# HH_APPLY_TRACE_ENABLED=1
# HH_APPLY_TRACE_RETENTION_DAYS=14
# HH_APPLY_TRACE_MAX_RUNS=100

# State directory (cookies, seen_vacancies, resume, debug files)
# JOB_HUNTER_HOME=~/.job-hunter
# ANALYTICS_ENABLED=1
# ANALYTICS_RECENT_DAYS=30
# ANALYTICS_MAX_DETAILS_CHARS=12000

# Telegram notifications (optional)
# HUNTER_BOT_TOKEN=123456:telegram-bot-token
# HUNTER_CONTROL_BOT_TOKEN=123456:telegram-bot-token
# HUNTER_NOTIFY_BOT_TOKEN=123456:telegram-bot-token
# NOTIFY_CHAT_ID=123456789
# JOB_HUNTER_TELEGRAM_AI_FREE_ANALYSES=1
# JOB_HUNTER_BOT_DEBUG_LOG_FILE=~/.job-hunter/telegram-bot-debug.jsonl
# TELEGRAM_DAILY_SUMMARY_ENABLED=1
# TELEGRAM_DAILY_SUMMARY_HOUR=20
# TELEGRAM_DAILY_SUMMARY_DAYS=1
# TELEGRAM_NOTIFY_SEARCH_STARTED=0
# TELEGRAM_NOTIFY_APPLICATIONS=0
# TELEGRAM_NOTIFY_ATTENTION_APPLICATIONS=1
# TELEGRAM_NOTIFY_SEARCH_SUMMARY=0
# TELEGRAM_NOTIFY_AUTO_DIGEST=0
# TELEGRAM_PROXY=socks5://127.0.0.1:7897

# AI Office integration (optional)
# OFFICE_URL=http://localhost:3000
# OFFICE_DB=/path/to/ai-office/database.sqlite
# AGENT_ID=hunter

# Global runtime
# HEADLESS=1
# SLOW_MO=500
# BROWSER_PROXY=http://127.0.0.1:7897

# Source toggles
# HH_ENABLED=1
# SUPERJOB_ENABLED=1
# HABR_ENABLED=1
# GEEKJOB_ENABLED=1

# Search queries
# Defaults are QA-focused, but you can replace them with your own targets.
# Use "||" as a separator for multiple values.
# HH_SEARCH_QUERIES=QA engineer||SDET||automation tester
# SUPERJOB_SEARCH_QUERIES=QA||qa engineer||sdet
#
# Habr Career uses category/listing paths instead of free-text queries.
# Example remote paths:
# HABR_SEARCH_PATHS=/vacancies/testirovschik_qa/remote||/vacancies/devops/remote
# HABR_SEARCH_PATHS=/vacancies/developer/remote||/vacancies/analyst/remote

# Application limits
# MAX_APPLICATIONS_PER_RUN=0
# MAX_AUTO_APPLICATIONS_PER_SOURCE=20
# SEARCH_INTERVAL_MIN=480
# INVITE_CHECK_INTERVAL_MIN=480

# Matcher strategy
# HH_MATCHER_AUTO_APPLY_MIN_SCORE=58
# HH_MATCHER_AUTO_APPLY_MIN_RESPONSE_SCORE=35
# Transient LLM failures are unscored, persisted and retried after cooldown.
# MATCHER_DEFER_COOLDOWN_SECONDS=300
# HH_RESUME_CLUSTER_STRATEGY_ENABLED=0

# hh staged resume pipeline (normal -> fun -> ats-heavy)
# HH_RESUME_PIPELINE_ENABLED=1
# HH_RESUME_RETRY_DELAY_HOURS=24
# HH_RESUME_RETRY_ON_SILENCE=0
# HH_RESUME_SILENCE_RETRY_DELAY_HOURS=72
# HH_RESUME_VIEWED_RETRY_DELAY_HOURS=72
# HH_RESUME_NOT_VIEWED_RETRY_DELAY_HOURS=72
# HH_RESUME_RETRY_DAILY_LIMIT=3
# HH_RESUME_RETRY_MAX_PER_COMPANY=1
# HH_RESUME_RETRY_COMPANY_LOOKBACK_DAYS=30
# HH_RESUME_RETRY_BLOCKED_COMPANIES=Acme Corp||Bad Recruiter LLC
# HH_RESUME_RETRY_MAX_CANDIDATES_PER_RUN=5
# HH_PRIMARY_RESUME_TITLE=QA Engineer / Manual QA / Test Engineer
# Recommended: exact HH resume ID; missing/ambiguous title resolution blocks apply.
# HH_PRIMARY_RESUME_ID=YOUR_PRIMARY_RESUME_ID
# HH_SECONDARY_RESUME_TITLE=QA Fun Variant
# HH_TERTIARY_RESUME_TITLE=QA ATS Heavy Variant

# Habr
# HABR_AUTO_APPLY=1
# HABR_MIN_SECONDS_BETWEEN_APPLICATIONS=10

# GeekJob
# GEEKJOB_AUTO_APPLY=1
# GEEKJOB_RESUME_ID=

# SuperJob
# SUPERJOB_API_KEY=put-your-superjob-api-key-here
# SUPERJOB_CLIENT_ID=123456
# SUPERJOB_AUTO_APPLY=1
# SUPERJOB_RESUME_ID=12345678

# Теневое второе мнение для HH: score 70–90, максимум 5 проверок за прогон.
# Решения об отклике не меняет; использует настроенных LLM-провайдеров.
HH_VERIFIER_SHADOW_ENABLED=1
